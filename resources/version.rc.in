// Windows version resource (generated by CMake from version.rc.in)
#include <winver.h>

// Application icon: shown for the .exe in Explorer, on shortcuts and in the taskbar.
// Qt's Windows plugin also uses IDI_ICON1 as the default window icon.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/pwp_logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Paint Matcher"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "PaintMatcher"
            VALUE "OriginalFilename", "PaintMatcher.exe"
            VALUE "ProductName",      "Paint Matcher"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
