<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>Paint Engine</Name>
    <Version>1.0.1</Version>
    <Title>Paint Engine 1.0.1 Setup</Title>
    <Publisher>Paint Engine</Publisher>
    <ProductUrl></ProductUrl>

    <!--
      Per-user install (%LOCALAPPDATA%\Programs\PaintEngine). The application writes
      settings.ini next to PaintEngine.exe, which is not allowed under Program Files
      without administrator rights, so a per-user folder is the default.
    -->
    <TargetDir>@HomeDir@/AppData/Local/Programs/PaintEngine</TargetDir>
    <StartMenuDir>Paint Engine</StartMenuDir>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>

    <!-- Icons, relative to this file. InstallerApplicationIcon is given without
         extension: binarycreator appends .ico on Windows. -->
    <InstallerApplicationIcon>pwp_logo</InstallerApplicationIcon>
    <InstallerWindowIcon>pwp_logo.png</InstallerWindowIcon>

    <MaintenanceToolName>PaintEngineMaintenanceTool</MaintenanceToolName>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>640</WizardDefaultWidth>
    <WizardDefaultHeight>480</WizardDefaultHeight>

    <RunProgram>@TargetDir@/PaintEngine.exe</RunProgram>
    <RunProgramDescription>Launch Paint Engine</RunProgramDescription>
</Installer>
